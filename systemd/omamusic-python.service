[Unit]
Description=OMA Music Python playback fallback
Documentation=https://github.com/lukejmorrison/omamusic
After=graphical-session.target sound.target
Wants=sound.target

[Service]
Type=simple
Environment=PULSE_LATENCY_MSEC=30
ExecStart=%h/.local/share/omamusic/venv/bin/python %h/.local/lib/omamusic/server.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=8
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

# Never enable this unit at login. The plugin starts it on demand.
