[Unit]
Description=Oma Music playback backend
Documentation=https://github.com/lukejmorrison/omarchy
After=graphical-session.target sound.target
Wants=sound.target

[Service]
Type=simple
Environment=PULSE_LATENCY_MSEC=30
ExecStart=%h/.local/bin/omamusic serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=8
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

# Never enable this unit at login. The player starts it on demand.
