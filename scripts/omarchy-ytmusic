#!/usr/bin/env bash
set -euo pipefail
# Compatibility alias. Prefer `omamusic`.
if [[ -x $HOME/.local/bin/omamusic ]]; then
  exec "$HOME/.local/bin/omamusic" "$@"
fi
if command -v omamusic >/dev/null 2>&1; then
  exec omamusic "$@"
fi
echo "omamusic: CLI is not installed. Run scripts/setup.sh" >&2
exit 3
